<Window x:Class="DevDock.App.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevDock Boot Loader"
        Width="520" Height="330"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Pulsing glow animation for the logo -->
        <Storyboard x:Key="GlowPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="LogoGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.4" To="0.9" Duration="0:0:1.5" />
            <DoubleAnimation Storyboard.TargetName="LogoScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.97" To="1.03" Duration="0:0:1.5" />
            <DoubleAnimation Storyboard.TargetName="LogoScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.97" To="1.03" Duration="0:0:1.5" />
        </Storyboard>

        <!-- Custom smooth styled ProgressBar -->
        <Style x:Key="CyberProgressBar" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid Background="#0D1522" ClipToBounds="True">
                            <Border CornerRadius="3" Background="#111B2A" />
                            <Border x:Name="PART_Track" CornerRadius="3" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#10B981" Offset="0.0" />
                                        <GradientStop Color="#06B6D4" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <!-- Outer cyber container with gradient border and neon glow -->
        <Border CornerRadius="16" Background="#0A0E17" BorderThickness="1.5">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#10B981" Offset="0.0" />
                    <GradientStop Color="#1E293B" Offset="0.5" />
                    <GradientStop Color="#06B6D4" Offset="1.0" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect Color="#10B981" BlurRadius="24" ShadowDepth="0" Opacity="0.45" />
            </Border.Effect>

            <Grid Margin="24">
                <!-- Top Header: Brand badge -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Border CornerRadius="6" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" Padding="8,3">
                        <TextBlock Text="v1.0.0 PRO" FontSize="10" FontWeight="Bold" Foreground="#34D399" />
                    </Border>
                </StackPanel>

                <!-- Center Content: Logo, Title & Subtitle -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-10,0,0">
                    <!-- Glowing animated Logo container -->
                    <Grid Width="74" Height="74" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Ellipse x:Name="LogoGlow" Width="70" Height="70" Fill="#10B981" Opacity="0.5">
                            <Ellipse.Effect>
                                <BlurEffect Radius="22" />
                            </Ellipse.Effect>
                        </Ellipse>

                        <Border CornerRadius="18" BorderThickness="1.5">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#34D399" Offset="0.0" />
                                    <GradientStop Color="#06B6D4" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0B1320" Offset="0.0" />
                                    <GradientStop Color="#060A10" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="LogoScale" CenterX="37" CenterY="37" />
                            </Border.RenderTransform>

                            <!-- Center Vector Dock Prompt -->
                            <Viewbox Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="48" Height="48">
                                    <!-- Terminal prompt > -->
                                    <Path Data="M12,14 L24,24 L12,34" Stroke="#34D399" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <!-- Terminal cursor _ -->
                                    <Line X1="26" Y1="34" X2="36" Y2="34" Stroke="#06B6D4" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <!-- Spark lightning bolt -->
                                    <Path Data="M32,10 L25,20 L30,20 L24,30 L36,19 L30,19 Z" Fill="#F59E0B" Opacity="0.9" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Grid>

                    <!-- Title -->
                    <TextBlock Text="DevDock" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#06B6D4" BlurRadius="12" ShadowDepth="0" Opacity="0.4" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Subtitle -->
                    <TextBlock Text="MODERN DEVELOPER COMMAND CENTER" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Bottom Status & Progress Section -->
                <StackPanel VerticalAlignment="Bottom">
                    <Grid Margin="0,0,0,8">
                        <TextBlock x:Name="StatusText" Text="Đang khởi động hệ thống DevDock..." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Left" />
                        <TextBlock x:Name="PercentText" Text="15%" FontSize="12" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" />
                    </Grid>

                    <ProgressBar x:Name="ProgressBar" Height="6" Maximum="100" Value="15" Style="{StaticResource CyberProgressBar}" />

                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Fast · Keyboard-first · Built for Windows" FontSize="10" Foreground="#475569" HorizontalAlignment="Left" />
                        <TextBlock Text="⚡ Kestrel Core" FontSize="10" Foreground="#10B981" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
