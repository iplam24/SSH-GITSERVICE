<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DevDock.Core\DevDock.Core.csproj" />
    <ProjectReference Include="..\DevDock.Security\DevDock.Security.csproj" />
    <ProjectReference Include="..\DevDock.Projects\DevDock.Projects.csproj" />
    <ProjectReference Include="..\DevDock.Git\DevDock.Git.csproj" />
    <ProjectReference Include="..\DevDock.SSH\DevDock.SSH.csproj" />
    <ProjectReference Include="..\DevDock.Terminal\DevDock.Terminal.csproj" />
    <ProjectReference Include="..\DevDock.Settings\DevDock.Settings.csproj" />
    <ProjectReference Include="..\DevDock.Plugins\DevDock.Plugins.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="app.ico" />
    <Content Include="Create-Desktop-Shortcut.cmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
