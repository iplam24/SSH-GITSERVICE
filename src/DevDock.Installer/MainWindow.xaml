<Window x:Class="DevDock.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt DevDock"
        Width="640" Height="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Custom CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Cyber Button Primary -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#10B981" Offset="0.0" />
                        <GradientStop Color="#06B6D4" Offset="1.0" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#04070B" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyber Button Secondary -->
        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="#334155" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#334155" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyber ProgressBar -->
        <Style x:Key="InstallerProgressBar" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid Background="#0D1522" ClipToBounds="True">
                            <Border CornerRadius="4" Background="#111B2A" />
                            <Border x:Name="PART_Track" CornerRadius="4" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#10B981" Offset="0.0" />
                                        <GradientStop Color="#06B6D4" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border CornerRadius="16" Background="#0A0E17" BorderThickness="1.5">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#10B981" Offset="0.0" />
                    <GradientStop Color="#1E293B" Offset="0.5" />
                    <GradientStop Color="#06B6D4" Offset="1.0" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect Color="#10B981" BlurRadius="28" ShadowDepth="0" Opacity="0.35" />
            </Border.Effect>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. Header Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Logo Square -->
                        <Border Width="40" Height="40" CornerRadius="10" Background="#0F172A" BorderBrush="#10B981" BorderThickness="1.5" Margin="0,0,14,0">
                            <Viewbox Width="26" Height="26">
                                <Canvas Width="48" Height="48">
                                    <Path Data="M12,14 L24,24 L12,34" Stroke="#34D399" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <Line X1="26" Y1="34" X2="36" Y2="34" Stroke="#06B6D4" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Path Data="M32,10 L25,20 L30,20 L24,30 L36,19 L30,19 Z" Fill="#F59E0B" />
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Cài đặt DevDock" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" />
                            <TextBlock Text="Developer Command Center — v1.0.0 Pro" FontSize="11" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Close (X) button -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="30" Height="30" Click="BtnClose_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="6" Background="Transparent" Padding="4">
                                    <TextBlock Text="✕" FontSize="14" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <Separator Grid.Row="0" VerticalAlignment="Bottom" Margin="0,0,0,-4" Background="#1E293B" />

                <!-- 2. Content Area (Config View or Progress View) -->
                <Grid Grid.Row="1" Margin="0,16,0,16">

                    <!-- VIEW 1: Configuration Form -->
                    <StackPanel x:Name="ConfigView" Visibility="Visible">
                        <!-- Path selection -->
                        <TextBlock Text="Thư mục cài đặt:" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtInstallPath" Grid.Column="0" Height="36" Padding="10,6" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" FontSize="12" VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Content="Duyệt..." Margin="8,0,0,0" Height="36" Style="{StaticResource BtnSecondary}" Click="BtnBrowse_Click" />
                        </Grid>

                        <!-- Integration options -->
                        <TextBlock Text="Tùy chọn tích hợp hệ thống Windows:" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,8" />
                        <Border CornerRadius="10" Background="#0B1320" BorderBrush="#1E293B" BorderThickness="1" Padding="14,10">
                            <StackPanel>
                                <CheckBox x:Name="ChkDesktop" Content="Tạo biểu tượng ngoài màn hình chính (Desktop Shortcut)" IsChecked="True" />
                                <CheckBox x:Name="ChkStartMenu" Content="Thêm lối tắt vào menu Start (Start Menu Programs)" IsChecked="True" />
                                <CheckBox x:Name="ChkPath" Content="Thêm lệnh 'devdock' vào biến môi trường PATH người dùng" IsChecked="True" />
                                <CheckBox x:Name="ChkContextMenu" Content="Thêm 'Mở bằng DevDock' vào menu chuột phải Windows Explorer" IsChecked="True" />
                                <CheckBox x:Name="ChkLaunch" Content="Tự động khởi chạy DevDock ngay sau khi cài đặt hoàn tất" IsChecked="True" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- VIEW 2: Progress & Finish View -->
                    <StackPanel x:Name="ProgressView" Visibility="Collapsed" VerticalAlignment="Center">
                        <!-- Icon indicator -->
                        <Border x:Name="IconFinish" Width="60" Height="60" CornerRadius="30" Background="#064E3B" BorderBrush="#10B981" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,16" Visibility="Collapsed">
                            <TextBlock Text="✓" FontSize="30" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock x:Name="TxtProgressHeader" Text="Đang tiến hành cài đặt..." FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,10" />

                        <Grid Margin="10,0,10,6">
                            <TextBlock x:Name="TxtStatus" Text="Đang chuẩn bị tệp..." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Left" />
                            <TextBlock x:Name="TxtPercent" Text="0%" FontSize="12" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" />
                        </Grid>

                        <ProgressBar x:Name="InstallProgressBar" Height="8" Maximum="100" Value="0" Style="{StaticResource InstallerProgressBar}" Margin="10,0" />

                        <TextBlock x:Name="TxtProgressNote" Text="Quá trình này chỉ mất vài giây. Vui lòng không tắt cửa sổ." FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    </StackPanel>
                </Grid>

                <!-- 3. Bottom Action Buttons -->
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <!-- Config View Buttons -->
                    <StackPanel x:Name="PanelConfigButtons" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Visible">
                        <Button Content="Hủy bỏ" Style="{StaticResource BtnSecondary}" Margin="0,0,10,0" Click="BtnClose_Click" />
                        <Button x:Name="BtnInstall" Content="Cài đặt ngay" Style="{StaticResource BtnPrimary}" Click="BtnInstall_Click" />
                    </StackPanel>

                    <!-- Finish View Buttons -->
                    <StackPanel x:Name="PanelFinishButtons" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                        <Button x:Name="BtnFinish" Content="Hoàn tất &amp; Đóng" Style="{StaticResource BtnPrimary}" Click="BtnFinish_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
